# Copy to .env (git-ignored) or export in your shell. Never commit real values.
# Kaggle API (choose ONE method; or put kaggle.json in ~/.kaggle/ with chmod 600)
KAGGLE_API_TOKEN=
# Legacy key pair:
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Logging level for the app and CLI
HTA_LOG_LEVEL=INFO

# Streamlit: keep the server local unless you add authentication in front of it
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=1024
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
